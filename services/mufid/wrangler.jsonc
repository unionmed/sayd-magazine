{
  "name": "sayd-mufid-internal",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": {"enabled": false},
  "vars": {
    "ENABLED": "false",
    "ALLOWED_ORIGINS": "http://localhost:8080,http://127.0.0.1:8080",
    "OPENAI_MODEL": "",
    "WEB_ENABLED": "false",
    "DAILY_REQUEST_LIMIT": "50",
    "PER_CLIENT_DAILY_LIMIT": "10",
    "PER_CLIENT_MINUTE_LIMIT": "3"
  },
  "durable_objects": {"bindings": [{"name": "GUARD", "class_name": "MufidGuard"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["MufidGuard"]}]
}
